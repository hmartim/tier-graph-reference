{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tier-graph-reference/fixture.schema.json",
  "title": "TIER-Graph public conformance case",
  "type": "object",
  "required": [
    "caseId",
    "title",
    "specificationVersion",
    "operation"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "specificationVersion": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "competencyQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}